# Sign in with X through Privy (see README: "Setting up Sign in with X")
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Demo mode (default): in-memory tokens, bots allowed
LEDGER=mock
PORT=8787
STARTER_BALANCE=1000
MIN_STAKE=1
MAX_STAKE=10000
# Fees in basis points (200 = 2%). The pot fee is fixed in the escrow config.
DEPOSIT_FEE_BPS=200
WITHDRAW_FEE_BPS=200
DEMO_PHANTOM_BALANCE=1000

# Solana mode (devnet testing). Players sign in with Phantom.
# LEDGER=solana
# SOLANA_RPC=https://api.devnet.solana.com
# PROGRAM_ID=
# TOKEN_MINT=
# TOKEN_SYMBOL=
# AUTHORITY_KEYPAIR=./authority-keypair.json
# HOUSE_WALLET=
